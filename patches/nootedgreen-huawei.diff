+uint64_t Gen11::wrapHwSetCursorImage(void *that, void *fb, void *info)
+{
+	uint64_t ret = FunctionCast(wrapHwSetCursorImage, callback->oHwSetCursorImage)(that, fb, info);
+
+	bool installed = xeCursorShadowInstall(that);
+	// the image of this call went through the aperture before the switch: write it again, now directly
+	if (installed) ret = FunctionCast(wrapHwSetCursorImage, callback->oHwSetCursorImage)(that, fb, info);
+
+	static uint32_t n = 0;
+	if (n < 16 || installed || (n % 512) == 0)
+		SYSLOG("ngreen", "XE-CURDIAG[%u]: hwSetCursorImage fb=%p -> 0x%llx CUR_BASE=0x%x page=0x%llx va=%p ggtt=0x%x%s",
+		       n, fb, ret, NGreen::callback->readReg32(0x70084),
+		       xeGgttPhys(NGreen::callback->readReg32(0x70084) & ~0xFFFu),
+		       getMember<void *>(that, 0xc98), getMember<uint32_t>(that, 0xdc0), installed ? " installed" : "");
+	n++;
+	return ret;
+}
