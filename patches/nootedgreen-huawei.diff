+	       (r >= 0x168000 && r < 0x16E000) || r == 0x1010A0 || r == 0x1010A4 ||
+	       (r >= 0x64300 && r < 0x64500) || r == 0x61400 || r == 0x62400 ||
+	       (r >= 0x46000 && r < 0x46040) || (r >= 0x46100 && r < 0x46120) || (r >= 0x164280 && r < 0x164290) ||
