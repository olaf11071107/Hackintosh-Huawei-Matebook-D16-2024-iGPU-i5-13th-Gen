+			OSSafeReleaseNULL(xeShadow);
+			SYSLOG("ngreen", "XE-CURSHADOW: allocation failed");
+			return false;
+		}
+		xeShadowVA = static_cast<uint8_t *>(xeShadow->getBytesNoCopy());
+	}
+
+	// carry the current contents over (read through Apple's mapping, only the two 256 KB cursor buffers known to be
+	// mapped there; the rest stays zero), then switch the PTEs and the CPU pointer
+	bzero(xeShadowVA, len);
+	for (uint32_t off = 0; off < len && off < 0x80000; off += 8)
+		*reinterpret_cast<uint64_t *>(xeShadowVA + off) = *reinterpret_cast<volatile uint64_t *>(appleVA + off);
+	asm volatile("sfence" ::: "memory");
+	for (uint32_t off = 0; off < len; off += 4096) {
+		uint32_t idx = (g0 + off) >> 12;
+		uint64_t pte = NGreen::callback->readGgttPte(idx);
+		uint64_t phys = xeShadow->getPhysicalSegment(off, nullptr, kIOMemoryMapperNone);
+		NGreen::callback->writeGgttPte(idx, (phys & ~0xFFFULL) | (pte & 0xFFF));
+	}
+	(void)NGreen::callback->readGgttPte((g0 + (uint32_t)len - 4096) >> 12);
+	NGreen::callback->writeReg32(0x101008, 1);   // GFX_FLSH_CNTL: flush GGTT TLB
+	SYSLOG("ngreen", "XE-CURSHADOW: installed, GGTT 0x%x len 0x%zx, CPU pointer %p -> %p, shadow phys 0x%llx",
+	       g0, len, appleVA, xeShadowVA, (uint64_t)xeShadow->getPhysicalSegment(0, nullptr, kIOMemoryMapperNone));
+	appleVA = xeShadowVA;
+	return true;
+}
