+// XE-GMS4: see the route comment. initSegments leaves [0xa0,0xa8) = [0, stolen) and
+// [0xb0,0xb8) = [stolen, gttSize - stolen); recompute both with the 4 MB encoding.
+bool Gen11::initSegments(void *that)
+{
+	bool ok = FunctionCast(initSegments, callback->oinitSegments)(that);
+	void *accel = getMember<void *>(that, 0x10);
+	IOPCIDevice *igpu = NGreen::callback ? NGreen::callback->getIGPU() : nullptr;
+	if (!ok || !accel || !igpu || getMember<uint8_t>(accel, 0x128c) != 0)
+		return ok;
+
+	uint16_t ggc = igpu->configRead16(WIOKit::kIOPCIConfigGraphicsControl);
+	uint32_t gms = ggc >> 8;
+	uint64_t base = getMember<uint64_t>(that, 0xa8);
+	uint64_t total = base + getMember<uint64_t>(that, 0xb8);  // wraps back to the GTT size
+	uint64_t stolen = base;
+	if (gms >= 0xF0 && gms <= 0xFE) {
+		// NGreen's decoded size, raised to at least 128 MB. Larger than the framebuffer's real stolen
+		// size (XE-GMS4-FB), which is safe here: this is only where per-task GPU addresses start.
+		stolen = NGreen::callback->stolen_size;
+		if (stolen == 0)
+			stolen = ((gms & 0x0F) + 1) * 4ULL * 1024 * 1024;
+		stolen = (stolen + 0x1FFFFFFULL) & ~0x1FFFFFFULL;  // keep Apple's 32 MB granularity
+	}
+	SYSLOG("ngreen", "XE-GMS4: GGC=0x%04x GMS=0x%02x base=0x%llx gtt=0x%llx -> base=0x%llx",
+	       ggc, gms, base, total, stolen);
+	if (stolen != base && stolen < total) {
+		getMember<uint64_t>(that, 0xa8) = stolen;
+		getMember<uint64_t>(that, 0xb0) = stolen;
+		getMember<uint64_t>(that, 0xb8) = total - stolen;
+	}
+	return ok;
+}
