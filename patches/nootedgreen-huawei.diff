+// XE-HDMI: ngreenhdmi=<DDI> puts an HDMI connector on that DDI (1/2 = combo B/C, 3..8 = TC1..TC6). On the Huawei
+// MCLG-XX the HDMI socket is TC2 in legacy mode (SDEISR bit 25 live with a monitor attached; only GMBUS pin 10
+// answered). Apple's hwDoGMBusRequest only accepts bus numbers below 8 and writes them straight into the GMBUS0
+// pin field, so a TC port's pin (DDI + 6) cannot be named: the connector gets placeholder bus 7 and GMBUS0 writes
+// selecting pin 7 are redirected to the real pin.
+static uint32_t xeHdmiDdi() {
+	static int ddi = -1;
+	if (ddi < 0) { ddi = 0; PE_parse_boot_argn("ngreenhdmi", &ddi, sizeof(ddi)); if (ddi < 1 || ddi > 8) ddi = 0; }
+	return (uint32_t)ddi;
+}
+static uint32_t xeHdmiBus() { uint32_t d = xeHdmiDdi(); return d >= 3 ? 7 : d + 1; }
+static uint32_t xeHdmiPin() { uint32_t d = xeHdmiDdi(); return d >= 3 ? d + 6 : d + 1; }
