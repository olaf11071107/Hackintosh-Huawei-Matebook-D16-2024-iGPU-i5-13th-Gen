+
+	auto *bmd = OSDynamicCast(IOBufferMemoryDescriptor, getMember<OSObject *>(controller, 0xcd0));
+	uint8_t *&appleVA = getMember<uint8_t *>(controller, 0xc98);      // where hwSetCursorImage writes
+	uint32_t g0 = getMember<uint32_t>(controller, 0xdc0);              // GGTT address appleVA maps
+	if (!bmd || !appleVA || !g0) return false;
+	if (xeShadow && appleVA == xeShadowVA) return false;               // installed and still in use
+	size_t len = bmd->getLength();
+	if (len == 0 || len > 0x400000 || (len & 0xFFF)) return false;
+
+	// only take over what is verifiably Apple's cursor range: GGTT page i -> buffer offset i
+	for (uint32_t off = 0; off < len; off += 4096) {
+		if (xeGgttPhys(g0 + off) != bmd->getPhysicalSegment(off, nullptr, kIOMemoryMapperNone)) {
+			static bool logged = false;
+			if (!logged) SYSLOG("ngreen", "XE-CURSHADOW: GGTT 0x%x+0x%x is not Apple's cursor buffer, not installing", g0, off);
+			logged = true;
+			return false;
+		}
+	}
+
+	if (xeShadow && xeShadow->getLength() < len) xeShadow = nullptr;   // Apple grew the range: new shadow (old one kept, never freed)
+	if (!xeShadow) {
+		xeShadow = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+			kIODirectionInOut | kIOMapWriteCombineCache, len, 0x7FFFFFF000ULL);
